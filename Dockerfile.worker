FROM oven/bun:1-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN bun install

# Copy source code
COPY . .

# Set environment to production (optional, but good for some libs)
# ENV NODE_ENV=production

# Run the worker
# tsx automatically uses tsconfig.json for paths
CMD ["bun", "run", "src/workers/health-monitor.ts"]
