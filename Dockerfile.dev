FROM node:20-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache libc6-compat python3 make g++

# Install dependencies first (for caching)
COPY package.json package-lock.json* ./
RUN npm install

# Copy rest of the code (though it will be overridden by volume in dev)
COPY . .

# Expose ports: Next.js (3000), HMR/WSS (optional, usually over 3000)
EXPOSE 3000

# Set environment
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

# Start avec tsx watch for hot reloading
CMD ["npx", "tsx", "watch", "server.ts"]
